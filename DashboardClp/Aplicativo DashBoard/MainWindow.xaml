                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="LedTrip67A"
                     Style="{StaticResource TripLedStyle}"/>
                            <TextBlock x:Name="TxtTrip67A"
