                    Margin="0,10,0,0" 
                    Width="500"/>
                <UniformGrid Columns="3" Width="500">

                    <!-- CORRENTE FASE A -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Height="60"
                        Padding="18,10,18,10" Width="160" Margin="0,0,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Fase A"
                                Style="{StaticResource MetricLabelStyle}"
                                Height="18" FontSize="12"/>
                            <TextBlock
                                x:Name="TxtCorrenteFaseA"
                                Text="-- A"
                                Style="{StaticResource MetricValueStyle}"
                                Height="30" FontSize="20" Margin="0,0,0,0"/>

