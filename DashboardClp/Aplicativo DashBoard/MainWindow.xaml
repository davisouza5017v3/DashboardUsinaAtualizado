                       VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>


                    <!-- ===================================================== -->
                    <!-- COLUNA 5 - 51 -->
                    <!-- ===================================================== -->

                    <StackPanel Grid.Column="4">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="LedTrip51A"
                     Style="{StaticResource TripLedStyle}"/>
                            <TextBlock x:Name="TxtTrip51A"
                       Text="51A"
                       Foreground="#9CA3AF"
                       FontSize="12"
                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="LedTrip51B"
                     Style="{StaticResource TripLedStyle}"/>
                            <TextBlock x:Name="TxtTrip51B"
                       Text="51B"
                       Foreground="#9CA3AF"
                       FontSize="12"
                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="LedTrip51C"
                     Style="{StaticResource TripLedStyle}"/>
                            <TextBlock x:Name="TxtTrip51C"
