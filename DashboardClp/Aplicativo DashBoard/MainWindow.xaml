                    FontWeight="SemiBold"
                    Margin="0,10,0,0" 
                    Width="500"/>
                <UniformGrid Columns="3">

                    <!-- POTÊNCIA FASE A -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Height="60"
                        Padding="18,10,18,10" Width="160" Margin="0,0,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Ativa A"
