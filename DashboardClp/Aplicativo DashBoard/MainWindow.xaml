<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="Aplicativo_DashBoard.MainWindow"
    Title="DAS Dashboard"
    Width="1200"
    Height="706"
    MinWidth="950"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="#0B1220"
    FontFamily="Segoe UI">

    <Window.Resources>

        <!-- LED DE ALARME -->
        <Style x:Key="TripLedStyle" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="#6B7280"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <!-- CARTÃO PADRÃO -->
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- LABEL -->
        <Style x:Key="MetricLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- VALOR -->
        <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- BOTÃO -->
        <Style x:Key="DashboardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
        </Style>

    </Window.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- CABEÇALHO -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="0"
            Background="#111827"
            CornerRadius="12"
            Padding="16,10,20,10"
            Margin="0,0,0,10"
            Height="80"
            VerticalAlignment="Bottom">

            <DockPanel>

                <!-- STATUS -->
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Ellipse
                        x:Name="LedStatus"
                        Width="10"
                        Height="10"
                        Fill="#F59E0B"
                        Margin="0,0,9,0"/>

                    <TextBlock
                        x:Name="TxtStatusCabecalho"
                        Text="Desconectado"
                        Foreground="#F9FAFB"
                        FontSize="14"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <!-- TÍTULO -->
                <StackPanel>

                    <TextBlock
                        Text="DAS DASHBOARD"
                        Foreground="White"
                        FontSize="25"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Monitoramento do XP300 e do relé Pextron URP6000"
                        Foreground="#9CA3AF"
                        FontSize="13"
                        Margin="0,4,0,0"/>

                </StackPanel>

            </DockPanel>

        </Border>


        <!-- ====================================================== -->
        <!-- ÁREA PRINCIPAL -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="262"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <!-- ================================================== -->
            <!-- COMUNICAÇÃO / CONTROLE -->
            <!-- ================================================== -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}" Margin="6,6,6,6">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- TÍTULO -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,18">

                        <TextBlock
                            Text="COMUNICAÇÃO"
                            Foreground="#60A5FA"
                            FontSize="13"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Controlador XP300"
                            Foreground="White"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- IP -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,14">

                        <TextBlock
                            Text="Endereço IP"
                            Foreground="#9CA3AF"/>

                        <TextBox
                            x:Name="TxtIp"
                            Text="192.168.1.231"
                            Height="34"
                            Padding="10,7"
                            FontSize="14"
                            Background="#1F2937"
                            Foreground="White"
                            BorderBrush="#374151"/>

                    </StackPanel>


                    <!-- PORTA -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,0,0,18">

                        <TextBlock
                            Text="Porta TCP"
                            Foreground="#9CA3AF"
                            Margin="0,0,0,6"/>

                        <TextBox
                            x:Name="TxtPorta"
                            Text="502"
                            Height="35"
                            Padding="10,7"
                            FontSize="14"
                            Background="#1F2937"
                            Foreground="White"
                            BorderBrush="#374151"/>

                    </StackPanel>


                    <!-- BOTÕES DE COMUNICAÇÃO -->

                    <Button
                        x:Name="BtnConectar"
                        Grid.Row="2"
                        Content="CONECTAR"
                        Width="84"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnConectar_Click"
                        HorizontalAlignment="Left"
                        Margin="0,78,0,0"
                        Grid.RowSpan="2"/>


                    <!-- RESET -->

                    <Button
                        x:Name="BtnResetRele"
                        Grid.Row="2"
                        Content="RESET RELÉ"
                        Width="85"
                        Height="42"
                        Background="#555555"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnResetRele_Click"
                        IsEnabled="False"
                        HorizontalAlignment="Left"
                        Margin="121,78,0,0"
                        Grid.RowSpan="2"/>


                    <!-- STATUS DA CONEXÃO -->

                    <Border
                        Grid.Row="4"
                        Background="#1F2937"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,20,0,0"
                        VerticalAlignment="Top">

                        <StackPanel>

                            <TextBlock
                                Text="Estado da conexão"
                                Foreground="#9CA3AF"
                                FontSize="12"/>

                            <TextBlock
                                x:Name="TxtStatusConexao"
                                Text="Aguardando conexão"
                                Foreground="#FBBF24"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- MEDIÇÕES DO URP6000 -->
            <!-- ================================================== -->

            <StackPanel Grid.Column="1" Margin="0,0,300,0">

                <TextBlock
                    Text="MEDIÇÕES DO RELÉ"
                    Foreground="#60A5FA"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="2,0,0,2"/>

                <TextBlock Text="PROTEÇÕES"
           Foreground="#60A5FA"
           FontSize="10"
           FontWeight="Bold"
           Margin="6,0,0,6"/>

                <Grid Margin="6,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===================================================== -->
                    <!-- COLUNA 1 - 27 -->
                    <!-- ===================================================== -->

                    <StackPanel Grid.Column="0">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="LedTrip27A"
                     Style="{StaticResource TripLedStyle}"/>
                            <TextBlock x:Name="TxtTrip27A"
                       Text="27A"
                       Foreground="#9CA3AF"
                       FontSize="12"
                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
