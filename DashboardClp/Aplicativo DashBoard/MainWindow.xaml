                        </StackPanel>

                    </StackPanel>

                    <!-- ===================================================== -->
                    <!-- COLUNA 6 - 59 -->
                    <!-- ===================================================== -->

                    <StackPanel Grid.Column="5">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="LedTrip59A"
                 Style="{StaticResource TripLedStyle}"/>
                            <TextBlock x:Name="TxtTrip59A"
