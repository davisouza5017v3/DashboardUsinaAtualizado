                       VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>


                    <!-- ===================================================== -->
                    <!-- COLUNA 2 - 32 -->
                    <!-- ===================================================== -->

                    <StackPanel Grid.Column="1">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
