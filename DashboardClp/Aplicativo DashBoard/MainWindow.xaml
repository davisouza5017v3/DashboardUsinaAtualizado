                        </StackPanel>

                    </StackPanel>


                    <!-- ===================================================== -->
                    <!-- COLUNA 7 - 47 / 78 / 81 / 86 -->
                    <!-- ===================================================== -->

                    <StackPanel Grid.Column="7">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="LedTrip47"
                     Style="{StaticResource TripLedStyle}"/>
                            <TextBlock x:Name="TxtTrip47"
                       Text="47"
